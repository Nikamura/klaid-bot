{
  "name": "klaid-bot",
  "type": "module",
  "version": "1.0.1",
  "license": "MIT",
  "scripts": {
    "build": "rm -rf dist/ && tsc",
    "format": "biome format src/ --write && biome check src/ --write --unsafe",
    "lint": "biome check src/ && biome format src/",
    "preinstall": "npx only-allow pnpm",
    "start": "tsx watch --env-file=.env src/index.ts",
    "test": "c8 --all --reporter=text --reporter=html tsx --test src/__tests__/*.test.ts"
  },
  "dependencies": {
    "get-urls": "12.1.0",
    "grammy": "1.45.1",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@tsconfig/node24": "24.0.4",
    "@types/node": "24.13.3",
    "c8": "12.0.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.15.1"
}
